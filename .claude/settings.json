{
  "permissions": {
    "allow": [
      "Bash(python parse_daily_report.py:*)",
      "Bash(python scripts/validate_daily_data.py:*)",
      "Bash(git fetch:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/scripts/validate_daily_data.py\"; [ ! -f \"$f\" ] || python \"$f\" --hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/scripts/validate_daily_data.py\"; [ ! -f \"$f\" ] || python \"$f\" --hook"
          }
        ]
      }
    ]
  }
}
